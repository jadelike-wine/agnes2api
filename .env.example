# agnes2api 配置。`cp .env.example .env` 之后改下面两把口令，其余留空即用内置默认值。
#
# ⚠️ **留空 = 用默认值**，不是「设成空串」。`src/cli.rs` 的 `or_unset` 与 compose 的
# `${X:-默认}` 两边同口径：空串一律视同没设。这一条对 `DATA_DIR` / `PORT` 尤其要紧 ——
# 两边口径不一致的话，`PORT=` 会让 compose 发布 8080、容器内却监听到别处。

# ── 必填的两把口令 ────────────────────────────────────────────────────────

# 🔴 **网关口令**：发给下游用户，用来调 `/v1/*`。
# 四路都认：`Authorization: Bearer`、`x-api-key`、`x-goog-api-key`、`?key=`。
GATEWAY_TOKEN=

# 🔴 **管理口令**：网页面板的登录密码，也是 `/admin/api/*` 的唯一凭据。
# ⚠️ **管理接口只认 `X-Admin-Key` 请求头**，刻意不接受 `Authorization: Bearer`，
#    也不接受 `?key=` —— 口令进 URL 会落进浏览器历史 / Referer / 反代访问日志。
# ⚠️ 下限 24 位。今天**没有任何登录限速**，这条下限是唯一防线。
# ⚠️ 不设的话整棵 `/admin` 树连同面板一起不存在（回 404，不泄漏「这里有个后台」）。
ADMIN_TOKEN=

# ── 部署 ──────────────────────────────────────────────────────────────────

# 监听端口。compose 的端口映射两侧都跟它走。
PORT=

# 🔴 **数据目录。改它之前先看清楚。**
# `store.json` 是全部状态的唯一落点：上游 key、我们签发的子密钥、面板改过的配置、
# 用量与事件环。它落在这个目录下。
# ⚠️ 改了这里而不同步改 `docker-compose.yml` 的卷挂载 ⇒ 数据写进容器内层，
#    **下次 `docker compose up -d` 重建容器时整池 key 静默消失**，且没有任何报错。
DATA_DIR=

# 反代拓扑。设了之后才读 `X-Forwarded-For` / `CF-Connecting-IP` 取客户端 IP。
# 🔴 **`CF-Connecting-IP` 排在 `X-Forwarded-For` 前面，这条排序有前提**：
#    只有当 Cloudflare 真的在最前面时它才安全（CF 边缘会覆盖客户端自带的同名头）。
#    挂自建 nginx / Caddy 时**必须在反代上把 `CF-Connecting-IP` 剥掉** ——
#    否则攻击者自带一个就能压过反代写的 `X-Forwarded-For`。
TRUST_PROXY=

# ── 上游 ──────────────────────────────────────────────────────────────────

# Agnes 上游地址。留空用内置默认。
AGNES_BASE_URL=

# 上游超时两档（毫秒）。流式看**首字节**，非流式看**整轮**。
# ⚠️ 两档不许混：图片 / 视频生成是非流式且慢，拿流式那档的预算会 100% 失败，
#    还会把池中每把 key 各记一次 strike、三次请求把整池打进长冷却。
UPSTREAM_TIMEOUT_MS=
UPSTREAM_SYNC_TIMEOUT_MS=

# ── key 池 ────────────────────────────────────────────────────────────────

# 连续失败多少次进冷却。
MAX_STRIKES=

# 冷却时长（毫秒）。
COOLDOWN_STRIKE_MS=

# 负载均衡模式：`priority`（粘滞，默认）或 `balanced`（游标轮询）。
# ⚠️ 两种模式下**单次请求内失败都会换人**，粘滞只作用于跨请求。
LB_MODE=

# 池快照缓存 TTL（毫秒）。别的实例判定的冷却 / 剔除，最多晚这么久才看得到。
POOL_CACHE_TTL_MS=

# ── 用量统计 ──────────────────────────────────────────────────────────────

# 关掉之后 `/admin/api/usage` 回 `200 + tier:"off"`（不是 404、不是 503）。
USAGE_STATS_ENABLED=

# 用量落盘间隔（毫秒）。这个值就是「未落盘的尾巴最长多久」的上界。
# ⚠️ 非法值**拒绝启动**，不降级 —— 这是部署配错，运维必须立刻看得见。
USAGE_FLUSH_INTERVAL_MS=
